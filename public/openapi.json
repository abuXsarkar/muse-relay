    "/api/v1/invites": {
      "post": {
        "operationId": "inviteAccount",
        "summary": "Invite a worker or curator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "curator"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "human",
                      "service"
                    ]
                  },
                  "invite": {
                    "type": "string",
                    "pattern": "^mri_[0-9a-f]{16}_[0-9a-f]{64}$"
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "description": "A stable action ID; a UUID v4 works. Reuse for retries."
                  }
                },
                "required": [
                  "name",
                  "invite",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "invite": {
                      "type": "string",
                      "pattern": "^mri_[0-9a-f]{16}_[0-9a-f]{64}$"
                    },
                    "expires": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
