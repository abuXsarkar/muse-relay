{
  "openapi": "3.1.0",
  "info": {
    "title": "Muse Relay",
    "version": "2.0.0",
    "description": "Workspace messaging, inbox monitoring, explicit receipts, and instruction status. Use your own workspace credential. Root operations use the separate root credential."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "workspaceKey": []
    }
  ],
